generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SaleCaseStatus {
  SETUP
  ACTIVE
  OFFERS
  DECISION
  COMPROMISE
}

enum PropertyType {
  APARTMENT
  HOUSE
  TOWNHOUSE
  VILLA
  OTHER
}

enum EpcLabel {
  A
  B
  C
  D
  E
  F
}

enum TaskCategory {
  ADMIN_LEGAL
  TECH_SAFETY
  COSMETIC_PRESENTATION
  MARKETING_SALES
}

enum CaseTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DocumentStatus {
  MISSING
  REQUESTED
  RECEIVED
  VALIDATED
}

enum ExpertRequestType {
  PRICE_VALIDATION
  NEGOTIATION_SUPPORT
  COMPROMISE_CHECK
  STRATEGIC_CALL
}

enum ExpertRequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saleCases SaleCase[]
}

model SaleCase {
  id               String             @id @default(cuid())
  userId           String
  title            String
  status           SaleCaseStatus     @default(SETUP)
  fixedFeeCents    Int
  city             String
  postalCode       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id])
  property         Property?
  externalValues   ExternalValuation[]
  internalValues   InternalValuation[]
  tasks            CaseTask[]
  documents        Document[]
  viewingSlots     ViewingSlot[]
  offers           Offer[]
  expertRequests   ExpertRequest[]
  paymentIntents   PaymentIntent[]

  @@index([userId])
}

model Property {
  id                   String      @id @default(cuid())
  saleCaseId           String      @unique
  address              String
  city                 String
  postalCode           String
  propertyType         PropertyType
  buildYear            Int
  epcLabel             EpcLabel
  renovationDuty       Boolean     @default(false)
  livingAreaSqm        Int
  plotAreaSqm          Int?
  bedrooms             Int
  conditionScore       Int
  hasGarden            Boolean     @default(false)
  hasParking           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  saleCase             SaleCase    @relation(fields: [saleCaseId], references: [id])

  @@index([saleCaseId])
}

model ExternalValuation {
  id            String   @id @default(cuid())
  saleCaseId    String
  estimatedEuro Int
  referenceId   String?
  valuationDate DateTime
  createdAt     DateTime @default(now())
  saleCase      SaleCase @relation(fields: [saleCaseId], references: [id])

  @@index([saleCaseId])
}

model InternalValuation {
  id          String              @id @default(cuid())
  saleCaseId  String
  anchorEuro  Int
  createdAt   DateTime            @default(now())
  saleCase    SaleCase            @relation(fields: [saleCaseId], references: [id])
  scenarios   ValuationScenario[]

  @@index([saleCaseId])
}

model ValuationScenario {
  id                 String             @id @default(cuid())
  internalValuationId String
  label              String
  priceEuro          Int
  estimatedDays      Int
  riskLevel          Int
  positives          String
  negatives          String
  createdAt          DateTime           @default(now())
  internalValuation  InternalValuation  @relation(fields: [internalValuationId], references: [id])

  @@index([internalValuationId])
}

model TaskTemplate {
  id            String       @id @default(cuid())
  category      TaskCategory
  title         String
  description   String?
  costMinEuro   Int
  costMaxEuro   Int
  durationDays  Int
  impactWeight  Int
  createdAt     DateTime     @default(now())
  tasks         CaseTask[]
}

model CaseTask {
  id            String        @id @default(cuid())
  saleCaseId    String
  templateId    String?
  title         String
  status        CaseTaskStatus @default(TODO)
  dueDate       DateTime?
  costEstimate  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  saleCase      SaleCase      @relation(fields: [saleCaseId], references: [id])
  template      TaskTemplate? @relation(fields: [templateId], references: [id])

  @@index([saleCaseId])
}

model DocumentType {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  required    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  documents   Document[]
}

model Document {
  id            String         @id @default(cuid())
  saleCaseId    String
  documentTypeId String
  status        DocumentStatus @default(MISSING)
  fileUrl       String?
  uploadedAt    DateTime?
  createdAt     DateTime       @default(now())
  saleCase      SaleCase       @relation(fields: [saleCaseId], references: [id])
  documentType  DocumentType   @relation(fields: [documentTypeId], references: [id])

  @@index([saleCaseId])
}

model ViewingSlot {
  id          String          @id @default(cuid())
  saleCaseId  String
  startTime   DateTime
  endTime     DateTime
  capacity    Int
  createdAt   DateTime        @default(now())
  saleCase    SaleCase        @relation(fields: [saleCaseId], references: [id])
  bookings    PublicBooking[]

  @@index([saleCaseId])
}

model PublicBooking {
  id           String      @id @default(cuid())
  viewingSlotId String
  name         String
  email        String
  phone        String?
  createdAt    DateTime    @default(now())
  viewingSlot  ViewingSlot @relation(fields: [viewingSlotId], references: [id])

  @@index([viewingSlotId])
}

model Offer {
  id                 String        @id @default(cuid())
  saleCaseId         String
  priceEuro          Int
  financingCondition Boolean
  inspectionCondition Boolean
  compromiseDays     Int
  deedDays           Int
  depositEuro        Int
  includedItems      String?
  clauses            String?
  createdAt          DateTime      @default(now())
  saleCase           SaleCase      @relation(fields: [saleCaseId], references: [id])
  analysis           OfferAnalysis?

  @@index([saleCaseId])
}

model OfferAnalysis {
  id             String   @id @default(cuid())
  offerId        String   @unique
  netScore       Int
  riskScore      Int
  timingScore    Int
  complexityScore Int
  totalScore     Int
  explanation    String
  createdAt      DateTime @default(now())
  offer          Offer    @relation(fields: [offerId], references: [id])
}

model ExpertRequest {
  id          String              @id @default(cuid())
  saleCaseId  String
  type        ExpertRequestType
  status      ExpertRequestStatus @default(NEW)
  priceMinEuro Int
  priceMaxEuro Int
  notes       String?
  createdAt   DateTime            @default(now())
  saleCase    SaleCase            @relation(fields: [saleCaseId], references: [id])
  expertNotes ExpertNote[]

  @@index([saleCaseId])
}

model ExpertNote {
  id              String        @id @default(cuid())
  expertRequestId String
  author          String
  content         String
  createdAt       DateTime      @default(now())
  expertRequest   ExpertRequest @relation(fields: [expertRequestId], references: [id])

  @@index([expertRequestId])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  priceEuro   Int
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  paymentIntents PaymentIntent[]
}

model PaymentIntent {
  id          String        @id @default(cuid())
  saleCaseId  String?
  productId   String?
  amountEuro  Int
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  saleCase    SaleCase?     @relation(fields: [saleCaseId], references: [id])
  product     Product?      @relation(fields: [productId], references: [id])

  @@index([saleCaseId])
}
